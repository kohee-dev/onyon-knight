---
import { cargarSitio } from '../lib/sitio';
interface Props {
  /** Id del tema final de la pieza. */
  id?: string;
  /** false dentro de un elemento que ya es un enlace (tarjetas). El enlace es absoluto: las páginas se imprimen a PDF. */
  enlace?: boolean;
}
const { id, enlace = true } = Astro.props;
const sitio = await cargarSitio();
const tema = id ? sitio.catalogo.temas.find((t) => t.id === id) : undefined;
---
{tema && (enlace
  ? <a class="etiqueta-tema" href={new URL(`${sitio.base}temas/${tema.id}/`, sitio.sitioUrl).href}>{tema.nombre}</a>
  : <span class="etiqueta-tema">{tema.nombre}</span>)}
