---
import BotonIndice from '../../../../../components/BotonIndice.astro';
import Fecha from '../../../../../components/Fecha.astro';
import ImagenCaso from '../../../../../components/ImagenCaso.astro';
import Indice from '../../../../../components/Indice.astro';
import Recursos from '../../../../../components/Recursos.astro';
import { categoriaDe } from '../../../../../categorias';
import Base from '../../../../../layouts/Base.astro';
import { formatearHoras } from '../../../../../lib/formato';
import { cargarSitio } from '../../../../../lib/sitio';

export async function getStaticPaths() {
  const sitio = await cargarSitio();
  return sitio.unidades.flatMap((u) =>
    u.casos.map((c) => ({ params: { modulo: u.modulo.id, unidad: u.id, caso: c.pieza.fuente.id } })),
  );
}

const sitio = await cargarSitio();
const u = sitio.unidades.find((x) => x.modulo.id === Astro.params.modulo && x.id === Astro.params.unidad)!;
const c = u.casos.find((x) => x.pieza.fuente.id === Astro.params.caso)!;
const m = u.modulo;
const cat = categoriaDe(m.datos.ciclo)!;
const { fuente, render, fecha } = c.pieza;
const entradas = render.titulos.filter((t) => t.nivel <= 2).map((t) => ({ id: t.id, texto: t.texto, nivel: t.nivel }));
---
<Base titulo={`${fuente.datos.titulo} · ${m.id.toUpperCase()}`} descripcion={fuente.datos.resumen}>
  {entradas.length > 0 && <BotonIndice slot="cabecera-extra" />}
  <section class={`portada portada-caso ${cat.clase}`} aria-hidden="true">
    <div class="portada-imagen"><ImagenCaso imagen={render.cabecera} modulo={m} proporcion="cabecera" titulo={fuente.datos.titulo} /></div>
    <p class="portada-modulo">{m.datos.nombre} · {u.titulo}</p>
    <p class="portada-meta">{u.pie}</p>
    <p><span class="chip-caso">Caso práctico</span> {formatearHoras(fuente.datos.horas!)}</p>
    <h1 class="portada-titulo">{fuente.datos.titulo}</h1>
    <Fecha fecha={fecha} />
    <p class="portada-licencia">© Alejandro Bartolomé · {c.creditos.licenciaTexto.nombre}, salvo indicación expresa.<br />{new URL(c.url, sitio.sitioUrl).href}</p>
  </section>
  <p class="migas"><a href={sitio.base}>Inicio</a> › <a href={`${sitio.base}${m.id}/`}>{m.datos.nombre}</a> › <a href={u.url}>{u.titulo}</a></p>
  <div class="banner"><ImagenCaso imagen={render.cabecera} modulo={m} proporcion="cabecera" titulo={fuente.datos.titulo} /></div>
  <header class="unidad-cabecera caso-cabecera">
    <p class="meta"><span class="chip-caso">Caso práctico</span> {formatearHoras(fuente.datos.horas!)}</p>
    <h1>{fuente.datos.titulo}</h1>
    <Fecha fecha={fecha} />
    <a class="boton" href={c.urlPdf} download>PDF del caso</a>
  </header>
  {entradas.length > 0 && <Indice entradas={entradas} />}
  <article class="pieza contenido" id={fuente.id} set:html={render.html} />
  <Recursos creditos={c.creditos} />
</Base>
