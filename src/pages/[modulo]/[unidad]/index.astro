---
import Distintivo from '../../../components/Distintivo.astro';
import Menu from '../../../components/Menu.astro';
import TarjetaCaso from '../../../components/TarjetaCaso.astro';
import Fecha from '../../../components/Fecha.astro';
import Recursos from '../../../components/Recursos.astro';
import { categoriaDe } from '../../../categorias';
import Base from '../../../layouts/Base.astro';
import { formatearHoras } from '../../../lib/formato';
import { cargarSitio } from '../../../lib/sitio';

export async function getStaticPaths() {
  const sitio = await cargarSitio();
  return sitio.unidades.map((u) => ({ params: { modulo: u.modulo.id, unidad: u.id } }));
}

const sitio = await cargarSitio();
const u = sitio.unidades.find((x) => x.modulo.id === Astro.params.modulo && x.id === Astro.params.unidad)!;
const m = u.modulo;
const cat = categoriaDe(m.datos.ciclo)!;
const absoluta = (ruta: string) => new URL(ruta, sitio.sitioUrl).href;
const entradas = [
  ...u.teoria.flatMap((p) => [
    { id: p.fuente.id, texto: p.fuente.datos.titulo, nivel: 0 },
    ...p.render.titulos.filter((t) => t.nivel === 1).map((t) => ({ id: t.id, texto: t.texto, nivel: 1 })),
  ]),
  ...(u.casos.length ? [{ id: 'casos-practicos', texto: 'Casos prácticos', nivel: 0, clase: 'solo-pantalla' }] : []),
  { id: 'licencias-y-fuentes', texto: 'Licencias y fuentes', nivel: 0 },
  // Al imprimir, las tarjetas no salen: el índice apunta a la lista final de casos.
  ...(u.casos.length ? [{ id: 'casos-de-esta-unidad', texto: 'Casos prácticos de esta unidad', nivel: 0, clase: 'solo-impresion' }] : []),
];
---
<Base progreso titulo={`${u.titulo} · ${m.id.toUpperCase()}`}>
  <section class={`portada ${cat.clase}`} aria-hidden="true">
    <p class="portada-modulo">{m.datos.nombre}</p>
    <p class="portada-meta">{m.id.toUpperCase()} · {m.datos.codigo} · {m.datos.ciclo} · {m.datos.curso}.º</p>
    <h1 class="portada-titulo">{u.titulo}</h1>
    <p class="portada-unidad">{u.pie}</p>
    <Fecha fecha={u.fecha} />
    <p class="portada-licencia">© Alejandro Bartolomé · {u.creditos.licenciaTexto.nombre}, salvo indicación expresa.<br />{sitio.sitioUrl}{u.url.slice(1)}</p>
  </section>
  <p class="migas"><a href={sitio.base}>Inicio</a> › <a href={`${sitio.base}${m.id}/`}>{m.datos.nombre}</a></p>
  <header class="unidad-cabecera">
    <div class="cabecera-texto">
      <p class="meta">{m.datos.nombre} · {u.id.toUpperCase()}</p>
      <h1>{u.titulo}</h1>
      <Fecha fecha={u.fecha} />
    </div>
    {u.urlPdf && <a class="boton" href={u.urlPdf} download>PDF de teoría</a>}
  </header>

  <Menu entradas={u.teoria.length > 0 ? entradas : []} />

  {u.teoria.map((p) => (
    <section class="pieza" id={p.fuente.id}>
      <h2>{p.fuente.datos.titulo} <Distintivo pieza={p.fuente} /></h2>
      <Fecha fecha={p.fecha} />
      <div class="contenido" set:html={p.render.html} />
    </section>
  ))}

  {u.casos.length > 0 && (
    <section class="casos" id="casos-practicos" data-huella="ignorar">
      <h2>Casos prácticos</h2>
      <ul class="tarjetas-casos">
        {u.casos.map((c) => <TarjetaCaso caso={c} modulo={m} />)}
      </ul>
    </section>
  )}

  <Recursos creditos={u.creditos} />

  {u.casos.length > 0 && (
    <section class="solo-impresion lista-casos" id="casos-de-esta-unidad">
      <h2>Casos prácticos de esta unidad</h2>
      <ul>
        {u.casos.map((c) => (
          <li>
            <strong>{c.pieza.fuente.datos.titulo}</strong> ({formatearHoras(c.pieza.fuente.datos.horas!)})<br />
            Página: <a href={absoluta(c.url)}>{absoluta(c.url)}</a><br />
            PDF: <a href={absoluta(c.urlPdf)}>{absoluta(c.urlPdf)}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
