---
import '@fontsource-variable/nunito';
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import '../styles/print.css';
import { CATEGORIAS } from '../categorias';
import BotonMenu from '../components/BotonMenu.astro';
import BotonTema from '../components/BotonTema.astro';
import DesplegableModulos from '../components/DesplegableModulos.astro';
import { AUTOR, AUTOR_URL } from '../licencias';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Barra de progreso de lectura: solo en páginas de contenido (unidad, caso, apunte). */
  progreso?: boolean;
}
const { titulo, descripcion, progreso = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const urlSitio = new URL(base, Astro.site).href;
const cc = ['cc', 'by', 'nc', 'sa'];

// Colores de categoría generados desde src/categorias.ts (única fuente).
const cssCategorias = Object.values(CATEGORIAS)
  .map(
    (c) =>
      `.${c.clase}{--cat-fondo:${c.claro.fondo};--cat-texto:${c.claro.texto}}` +
      `:root[data-tema="oscuro"] .${c.clase}{--cat-fondo:${c.oscuro.fondo};--cat-texto:${c.oscuro.texto}}`,
  )
  .join('');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Onyon Knight</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}icono-512.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline>
      // Tema antes de pintar: elección guardada o, si no hay, la preferencia del sistema.
      (function () {
        var t = null;
        try { t = localStorage.getItem('onyon-tema'); } catch (e) {}
        if (t !== 'claro' && t !== 'oscuro') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro';
        document.documentElement.setAttribute('data-tema', t);
      })();
    </script>
    <style set:html={cssCategorias}></style>
  </head>
  <body>
    <header class="cabecera">
      <span class="cabecera-hueco" aria-hidden="true"></span>
      <div class="cabecera-inicio">
        <a class="marca" href={base}><img class="marca-imagen" src={`${base}img/caballero-96.webp`} srcset={`${base}img/caballero-192.webp 2x`} alt="" width="122" height="96" /><span>Onyon Knight</span></a>
        <DesplegableModulos />
      </div>
      <div class="cabecera-acciones">
        <BotonTema />
        <BotonMenu />
      </div>
      {progreso && <div class="progreso" aria-hidden="true" style="--progreso: 0"><span></span></div>}
    </header>
    <main>
      <slot />
    </main>
    <footer class="pie">
      <p class="pie-licencia">
        <a href={urlSitio}>Onyon Knight</a> © 2026 de <a href={AUTOR_URL}>{AUTOR}</a> está bajo licencia <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>{cc.map((i) => <img class="cc-icono" src={`${base}cc/${i}.svg`} alt="" />)}
      </p>
      <p>Salvo indicación expresa en cada recurso.</p>
      <p><a href={`${base}licencias/`}>Licencias y fuentes</a></p>
    </footer>
    <script>
      // Botones de tema (cabecera y menú): alternan modo claro / oscuro y recuerdan la elección.
      const botonesTema = document.querySelectorAll<HTMLButtonElement>('.tema-boton');
      const etiqueta = (t: string | null) => (t === 'oscuro' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      const etiquetar = (t: string | null) => botonesTema.forEach((b) => b.setAttribute('aria-label', etiqueta(t)));
      etiquetar(document.documentElement.dataset.tema ?? null);
      botonesTema.forEach((b) =>
        b.addEventListener('click', () => {
          const nuevo = document.documentElement.dataset.tema === 'oscuro' ? 'claro' : 'oscuro';
          document.documentElement.dataset.tema = nuevo;
          etiquetar(nuevo);
          try {
            localStorage.setItem('onyon-tema', nuevo);
          } catch {
            /* sin almacenamiento: el tema dura hasta recargar */
          }
        }),
      );

      // Botón «Copiar» en cada bloque de código (los diagramas Mermaid no lo llevan).
      const ICONO_COPIAR =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const ICONO_HECHO =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
      const copiarRespaldo = (texto: string) => {
        const area = document.createElement('textarea');
        area.value = texto;
        area.style.cssText = 'position:fixed;opacity:0';
        document.body.append(area);
        area.select();
        const hecho = document.execCommand('copy');
        area.remove();
        return hecho;
      };
      for (const pre of document.querySelectorAll<HTMLElement>('main pre:not(.mermaid)')) {
        const caja = document.createElement('div');
        caja.className = 'codigo';
        pre.replaceWith(caja);
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.className = 'copiar-codigo';
        boton.setAttribute('aria-label', 'Copiar código');
        boton.innerHTML = ICONO_COPIAR;
        const aviso = document.createElement('span');
        aviso.className = 'copiar-aviso';
        aviso.setAttribute('aria-live', 'polite');
        caja.append(pre, boton, aviso);
        let espera: number | undefined;
        boton.addEventListener('click', async () => {
          const texto = ((pre.querySelector('code') ?? pre).textContent ?? '').replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(texto);
          } catch {
            if (!copiarRespaldo(texto)) return;
          }
          boton.classList.add('copiado');
          boton.innerHTML = ICONO_HECHO;
          aviso.textContent = 'Copiado';
          clearTimeout(espera);
          espera = window.setTimeout(() => {
            boton.classList.remove('copiado');
            boton.innerHTML = ICONO_COPIAR;
            aviso.textContent = '';
          }, 2000);
        });
      }

      // Barra de progreso de lectura.
      const progreso = document.querySelector<HTMLElement>('.progreso');
      let pendiente = false;
      if (progreso) {
      const medir = () => {
        pendiente = false;
        const total = document.documentElement.scrollHeight - innerHeight;
        progreso?.style.setProperty('--progreso', String(total > 0 ? Math.min(1, scrollY / total) : 0));
      };
      addEventListener('scroll', () => {
        if (!pendiente) {
          pendiente = true;
          requestAnimationFrame(medir);
        }
      }, { passive: true });
      addEventListener('resize', medir);
      medir();
      }

      // Diagramas Mermaid con el tema de la página (el original se guarda para poder redibujar).
      async function dibujarDiagramas() {
        const diagramas = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
        if (!diagramas.length) return;
        for (const d of diagramas) {
          d.dataset.fuente ??= d.textContent ?? '';
          d.textContent = d.dataset.fuente;
          d.removeAttribute('data-processed');
        }
        const { default: mermaid } = await import('mermaid');
        const oscuro = document.documentElement.dataset.tema === 'oscuro';
        mermaid.initialize({ startOnLoad: false, theme: oscuro ? 'dark' : 'default', securityLevel: 'strict' });
        await mermaid.run({ nodes: diagramas });
      }

      // Señal para scripts/pdf.mjs: tipografías, imágenes y diagramas listos.
      async function prepararPagina() {
        const w = window as any;
        try {
          for (const img of document.images) img.loading = 'eager';
          await document.fonts.ready;
          await Promise.all(
            [...document.images].map((img) =>
              img.complete ? null : new Promise((r) => img.addEventListener('load', r) || img.addEventListener('error', r)),
            ),
          );
          await dibujarDiagramas();
          // Al cambiar de tema, los diagramas se redibujan con los colores del nuevo.
          new MutationObserver(() => dibujarDiagramas().catch(console.error)).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-tema'],
          });
        } catch (e) {
          w.__onyonError = String((e as Error)?.message ?? e);
          console.error(e);
        }
        w.__onyonListo = true;
      }
      prepararPagina();
    </script>
  </body>
</html>
