---
import '@fontsource-variable/nunito';
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import '../styles/print.css';
import { CATEGORIAS } from '../categorias';
import BotonMenu from '../components/BotonMenu.astro';
import BotonTema from '../components/BotonTema.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion } = Astro.props;
const base = import.meta.env.BASE_URL;

// Colores de categoría generados desde src/categorias.ts (única fuente).
const cssCategorias = Object.values(CATEGORIAS)
  .map(
    (c) =>
      `.${c.clase}{--cat-fondo:${c.claro.fondo};--cat-texto:${c.claro.texto}}` +
      `:root[data-tema="oscuro"] .${c.clase}{--cat-fondo:${c.oscuro.fondo};--cat-texto:${c.oscuro.texto}}`,
  )
  .join('');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Onyon Knight</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <script is:inline>
      // Tema antes de pintar: elección guardada o, si no hay, la preferencia del sistema.
      (function () {
        var t = null;
        try { t = localStorage.getItem('onyon-tema'); } catch (e) {}
        if (t !== 'claro' && t !== 'oscuro') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro';
        document.documentElement.setAttribute('data-tema', t);
      })();
    </script>
    <style set:html={cssCategorias}></style>
  </head>
  <body>
    <header class="cabecera">
      <span class="cabecera-hueco" aria-hidden="true"></span>
      <a class="marca" href={base}>Onyon Knight</a>
      <div class="cabecera-acciones">
        <BotonTema />
        <BotonMenu />
      </div>
      <div class="progreso" aria-hidden="true" style="--progreso: 0"><span></span></div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pie">
      <p>© Alejandro Bartolomé · CC BY-SA 4.0, salvo indicación expresa</p>
      <p><a href={`${base}licencias/`}>Licencias y fuentes</a></p>
    </footer>
    <script>
      // Botones de tema (cabecera y menú): alternan modo claro / oscuro y recuerdan la elección.
      const botonesTema = document.querySelectorAll<HTMLButtonElement>('.tema-boton');
      const etiqueta = (t: string | null) => (t === 'oscuro' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      const etiquetar = (t: string | null) => botonesTema.forEach((b) => b.setAttribute('aria-label', etiqueta(t)));
      etiquetar(document.documentElement.dataset.tema ?? null);
      botonesTema.forEach((b) =>
        b.addEventListener('click', () => {
          const nuevo = document.documentElement.dataset.tema === 'oscuro' ? 'claro' : 'oscuro';
          document.documentElement.dataset.tema = nuevo;
          etiquetar(nuevo);
          try {
            localStorage.setItem('onyon-tema', nuevo);
          } catch {
            /* sin almacenamiento: el tema dura hasta recargar */
          }
        }),
      );

      // Barra de progreso de lectura.
      const progreso = document.querySelector<HTMLElement>('.progreso');
      let pendiente = false;
      const medir = () => {
        pendiente = false;
        const total = document.documentElement.scrollHeight - innerHeight;
        progreso?.style.setProperty('--progreso', String(total > 0 ? Math.min(1, scrollY / total) : 0));
      };
      addEventListener('scroll', () => {
        if (!pendiente) {
          pendiente = true;
          requestAnimationFrame(medir);
        }
      }, { passive: true });
      addEventListener('resize', medir);
      medir();

      // Señal para scripts/pdf.mjs: tipografías, imágenes y diagramas listos.
      async function prepararPagina() {
        const w = window as any;
        try {
          for (const img of document.images) img.loading = 'eager';
          await document.fonts.ready;
          await Promise.all(
            [...document.images].map((img) =>
              img.complete ? null : new Promise((r) => img.addEventListener('load', r) || img.addEventListener('error', r)),
            ),
          );
          const diagramas = document.querySelectorAll<HTMLElement>('pre.mermaid');
          if (diagramas.length) {
            const { default: mermaid } = await import('mermaid');
            mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'strict' });
            await mermaid.run({ nodes: diagramas });
          }
        } catch (e) {
          w.__onyonError = String((e as Error)?.message ?? e);
          console.error(e);
        }
        w.__onyonListo = true;
      }
      prepararPagina();
    </script>
  </body>
</html>
