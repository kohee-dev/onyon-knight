---
interface Props {
  titulo: string;
  color?: string;
}
const { titulo, color } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Onyon Knight</title>
  </head>
  <body style={color ? `--color-modulo: ${color}` : undefined}>
    <header class="cabecera">
      <a class="marca" href={base}>Onyon Knight</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pie">
      <p>© Alejandro Bartolomé · CC BY-SA 4.0, salvo indicación expresa</p>
    </footer>
  </body>
</html>
